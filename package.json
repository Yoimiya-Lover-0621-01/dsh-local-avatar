{
    "name":  "@local/local-avatar",
    "version":  "1.0.0",
    "private":  true,
    "description":  "Replace the DeepSeek account avatar with a local image in the Harness Web UI.",
    "type":  "module",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-layout",
                                              "@deepseek-ai/dsh-client-ui-settings-general"
                                          ]
                           }
            },
    "license":  "MIT",
    "keywords":  [
                     "deepseek",
                     "deepseek-harness",
                     "dsh",
                     "avatar",
                     "plugin"
                 ],
    "homepage":  "https://gitee.com/\u003cyour-gitee-id\u003e/dsh-local-avatar#readme",
    "repository":  {
                       "type":  "git",
                       "url":  "https://gitee.com/\u003cyour-gitee-id\u003e/dsh-local-avatar.git"
                   }
}